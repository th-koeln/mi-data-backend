RewriteEngine On
# Produktiv unter /kirby (Alias). Lokal (composer dev) wird die .htaccess nicht genutzt.
RewriteBase /kirby

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L]

# Verzeichnis-Listings deaktivieren
Options -Indexes

# Zugriff auf interne Verzeichnisse sperren
RewriteRule ^(content|site|kirby)/(.*)$ - [F,L]
